---
import Base from '../layouts/Base.astro';
import type { Lang } from '../data/areas';
import { areas, areaById } from '../data/areas';
import { concepts, dependentsOf } from '../data/concepts';
import { formatRef } from '../data/books';
import { ui } from '../i18n/ui';
import { conceptUrl, mapUrl } from '../lib/paths';
import { isAvailable, isInteractive } from '../lib/available';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const other: Lang = lang === 'es' ? 'en' : 'es';
const available = concepts.filter((c) => isAvailable(c.id)).length;
const interactive = concepts.filter((c) => isInteractive(c.id)).length;

const payload = {
  t: {
    prereqs: t.panelPrereqs, dependents: t.panelDependents, books: t.panelBooks, open: t.panelOpen,
    upcoming: t.panelUpcoming, none: t.panelNone, noDependents: t.panelNoDependents, dlTitle: t.dlBadgeTitle,
    interactive: t.legendInteractive, interactiveTitle: t.interactiveTitle,
  },
  concepts: concepts.map((c) => ({
    id: c.id,
    slot: areaById[c.area].slot,
    areaName: areaById[c.area][lang],
    title: c.title[lang],
    short: c.short[lang],
    prereqs: c.prereqs,
    dependents: dependentsOf(c.id),
    dl: !!c.dl,
    interactive: isInteractive(c.id),
    url: conceptUrl(c, lang),
    refs: c.refs.map((r) => formatRef(r, lang)),
  })),
};
---
<Base lang={lang} alternate={mapUrl(other)}>
  <main>
    <section class="wrap map-intro">
      <p class="eyebrow">{t.mapEyebrow}</p>
      <h1>{t.mapTitle}</h1>
      <p class="lede">{t.mapLede}</p>
      <div class="map-controls">
        <button class="toggle" type="button" aria-pressed="false" data-dl-toggle>
          <span class="switch" aria-hidden="true"></span>{t.dlRoute}
        </button>
        <span class="legend"><span class="badge-int">{t.legendInteractive}</span></span>
        <span class="legend"><span class="badge-dl">DL</span>{t.dlBadgeTitle}</span>
        <span class="count">{t.countLabel(concepts.length, available, interactive)}</span>
      </div>
    </section>

    <div class="wrap map-layout">
      <div class="map-canvas" data-map>
        <svg class="map-edges" aria-hidden="true">
          <defs>
            <marker id="arrow-in" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M0 0L10 5L0 10Z" style="fill: var(--ink-2)" />
            </marker>
            <marker id="arrow-out" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M0 0L10 5L0 10Z" style="fill: var(--muted)" />
            </marker>
          </defs>
          <g data-edges></g>
        </svg>
        <div class="islands">
          {areas.map((area) => {
            const list = concepts.filter((c) => c.area === area.id);
            return (
              <section class="island" style={`--area: var(--area-${area.slot})`} aria-labelledby={`area-${area.id}`}>
                <header class="island-head">
                  <span class="area-dot" aria-hidden="true"></span>
                  <h2 id={`area-${area.id}`}>{area[lang]}</h2>
                  <span class="island-count">{list.length}</span>
                </header>
                <ul class="chips">
                  {list.map((c) => (
                    <li>
                      <button class="chip" type="button" aria-pressed="false" data-id={c.id} data-dl={c.dl ? '1' : '0'}>
                        <span class="chip-title">{c.title[lang]}</span>
                        {(isInteractive(c.id) || c.dl) && (
                          <span class="chip-meta">
                            {isInteractive(c.id) && <span class="badge-int" title={t.interactiveTitle}>{t.legendInteractive}</span>}
                            {c.dl && <span class="badge-dl" title={t.dlBadgeTitle}>DL</span>}
                          </span>
                        )}
                      </button>
                    </li>
                  ))}
                </ul>
              </section>
            );
          })}
        </div>
      </div>

      <aside class="panel" data-panel aria-live="polite">
        <span class="sheet-grip" aria-hidden="true"></span>
        <button class="icon-btn sheet-close" type="button" data-close aria-label={t.panelClose}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
        </button>
        <div class="panel-empty" data-empty>
          <h2>{t.panelHowTitle}</h2>
          <ul class="panel-how">
            {t.panelHow.map((line) => <li>{line}</li>)}
          </ul>
        </div>
        <div data-detail hidden></div>
      </aside>
    </div>
  </main>
  <script type="application/json" id="map-data" set:html={JSON.stringify(payload)}></script>
</Base>

<script>
  type C = {
    id: string; slot: number; areaName: string; title: string; short: string;
    prereqs: string[]; dependents: string[]; dl: boolean; interactive: boolean; url?: string; refs: string[];
  };
  const data = JSON.parse(document.getElementById('map-data')!.textContent || '{}');
  const t = data.t as Record<string, string>;
  const byId = new Map<string, C>((data.concepts as C[]).map((c) => [c.id, c]));
  const canvas = document.querySelector<HTMLElement>('[data-map]')!;
  const edges = canvas.querySelector<SVGGElement>('[data-edges]')!;
  const panel = document.querySelector<HTMLElement>('[data-panel]')!;
  const empty = panel.querySelector<HTMLElement>('[data-empty]')!;
  const detail = panel.querySelector<HTMLElement>('[data-detail]')!;
  const dlToggle = document.querySelector<HTMLButtonElement>('[data-dl-toggle]')!;
  const chips = new Map<string, HTMLElement>();
  canvas.querySelectorAll<HTMLElement>('.chip').forEach((el) => chips.set(el.dataset.id!, el));
  const narrow = matchMedia('(max-width: 1099.98px)');
  let selected: string | null = null;

  const esc = (s: string) => s.replace(/[&<>"']/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[ch]!);

  function box(el: Element) {
    const r = el.getBoundingClientRect();
    const c = canvas.getBoundingClientRect();
    return { x: r.left - c.left, y: r.top - c.top, w: r.width, h: r.height };
  }

  function curve(a: ReturnType<typeof box>, b: ReturnType<typeof box>) {
    const ac = a.x + a.w / 2, bc = b.x + b.w / 2;
    const y1 = a.y + a.h / 2, y2 = b.y + b.h / 2;
    if (Math.abs(ac - bc) < 40) {
      const x1 = a.x + a.w, x2 = b.x + b.w + 3;
      const bulge = 12 + Math.min(14, Math.abs(y2 - y1) * 0.04);
      return `M${x1} ${y1}C${x1 + bulge} ${y1} ${x2 + bulge} ${y2} ${x2} ${y2}`;
    }
    const right = bc > ac;
    const x1 = right ? a.x + a.w : a.x;
    const x2 = right ? b.x - 3 : b.x + b.w + 3;
    const dx = Math.max(40, Math.abs(x2 - x1) * 0.45) * (right ? 1 : -1);
    return `M${x1} ${y1}C${x1 + dx} ${y1} ${x2 - dx} ${y2} ${x2} ${y2}`;
  }

  function drawEdges() {
    edges.innerHTML = '';
    if (!selected) return;
    const c = byId.get(selected)!;
    const target = chips.get(selected)!;
    const paths: string[] = [];
    for (const p of c.prereqs) {
      const el = chips.get(p);
      if (el) paths.push(`<path class="edge-in" marker-end="url(#arrow-in)" d="${curve(box(el), box(target))}"/>`);
    }
    for (const d of c.dependents) {
      const el = chips.get(d);
      if (el) paths.push(`<path class="edge-out" marker-end="url(#arrow-out)" d="${curve(box(target), box(el))}"/>`);
    }
    edges.innerHTML = paths.join('');
  }

  function miniChips(ids: string[], emptyText: string) {
    if (!ids.length) return `<p class="muted-note">${esc(emptyText)}</p>`;
    return `<div class="mini-chips">${ids
      .map((id) => {
        const k = byId.get(id)!;
        return `<button type="button" class="mini-chip" data-go="${k.id}"><span class="area-dot" style="--area: var(--area-${k.slot})"></span>${esc(k.title)}</button>`;
      })
      .join('')}</div>`;
  }

  function renderDetail(c: C) {
    empty.hidden = true;
    detail.hidden = false;
    detail.innerHTML = `
      <div class="panel-area"><span class="area-dot" style="--area: var(--area-${c.slot})"></span>${esc(c.areaName)}</div>
      <h2 class="panel-title">${esc(c.title)}</h2>
      <p class="panel-short">${esc(c.short)}</p>
      <div class="panel-actions">
        ${c.url ? `<a class="btn-primary" href="${c.url}">${esc(t.open)} <span aria-hidden="true">→</span></a>` : `<span class="status-upcoming">${esc(t.upcoming)}</span>`}
        ${c.interactive ? `<span class="badge-int" title="${esc(t.interactiveTitle)}">${esc(t.interactive)}</span>` : ''}
        ${c.dl ? `<span class="badge-dl" title="${esc(t.dlTitle)}">DL</span>` : ''}
      </div>
      <div class="panel-section"><h3>${esc(t.prereqs)}</h3>${miniChips(c.prereqs, t.none)}</div>
      <div class="panel-section"><h3>${esc(t.dependents)}</h3>${miniChips(c.dependents, t.noDependents)}</div>
      <div class="panel-section"><h3>${esc(t.books)}</h3><ul class="ref-list">${c.refs.map((r) => `<li>${esc(r)}</li>`).join('')}</ul></div>`;
    detail.querySelectorAll<HTMLElement>('[data-go]').forEach((b) =>
      b.addEventListener('click', () => select(b.dataset.go!, true)),
    );
    panel.classList.add('open');
    panel.scrollTop = 0;
  }

  function select(id: string | null, scroll = false) {
    selected = id;
    chips.forEach((el) => {
      el.classList.remove('is-selected', 'is-prereq', 'is-dependent');
      el.setAttribute('aria-pressed', 'false');
    });
    if (!id || !byId.has(id)) {
      selected = null;
      canvas.classList.remove('has-selection');
      edges.innerHTML = '';
      detail.hidden = true;
      empty.hidden = false;
      panel.classList.remove('open');
      history.replaceState(null, '', location.pathname + location.search);
      return;
    }
    const c = byId.get(id)!;
    const el = chips.get(id)!;
    canvas.classList.add('has-selection');
    el.classList.add('is-selected');
    el.setAttribute('aria-pressed', 'true');
    c.prereqs.forEach((p) => chips.get(p)?.classList.add('is-prereq'));
    c.dependents.forEach((d) => chips.get(d)?.classList.add('is-dependent'));
    renderDetail(c);
    history.replaceState(null, '', '#' + id);
    const header = document.querySelector('.site-header')?.getBoundingClientRect().height ?? 60;
    const r = el.getBoundingClientRect();
    if (narrow.matches) {
      if (r.bottom > window.innerHeight * 0.36 || r.top < header) {
        window.scrollBy({ top: r.top - header - 16, behavior: 'smooth' });
      }
    } else if (scroll && (r.top < header || r.bottom > window.innerHeight)) {
      el.scrollIntoView({ block: 'center', behavior: 'smooth' });
    }
    requestAnimationFrame(drawEdges);
  }

  canvas.addEventListener('click', (e) => {
    const chip = (e.target as HTMLElement).closest<HTMLElement>('.chip');
    if (chip) select(chip.dataset.id === selected ? null : chip.dataset.id!);
    else select(null);
  });
  panel.querySelector('[data-close]')?.addEventListener('click', () => select(null));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') select(null); });

  function setDl(on: boolean) {
    dlToggle.setAttribute('aria-pressed', String(on));
    canvas.classList.toggle('dl-mode', on);
    try { localStorage.setItem('dlRoute', on ? '1' : '0'); } catch {}
  }
  dlToggle.addEventListener('click', () => setDl(dlToggle.getAttribute('aria-pressed') !== 'true'));
  try { if (localStorage.getItem('dlRoute') === '1') setDl(true); } catch {}

  new ResizeObserver(() => drawEdges()).observe(canvas);
  document.fonts?.ready.then(drawEdges);
  const initial = decodeURIComponent(location.hash.slice(1));
  if (initial && byId.has(initial)) requestAnimationFrame(() => select(initial, true));
</script>
